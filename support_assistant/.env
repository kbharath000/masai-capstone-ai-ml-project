# Copy this file's values in place and fill in your own — never commit real secrets.

# Groq API key, used only when MOCK_LLM=0 (see support_assistant.py). Get one at
# https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# "1" (default) = deterministic mock generation, no LLM calls, no API key needed.
# "0" = real Groq API calls for classify/answer generation.
MOCK_LLM=1
